# --- Obligatorio ---
# Firma de JWT (cualquier cadena larga aleatoria)
LLMM_SECRET_KEY=cambia-esto-por-una-cadena-aleatoria-larga
# Clave Fernet para cifrar credenciales. Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLMM_ENCRYPTION_KEY=
POSTGRES_PASSWORD=llm

# --- Opcional ---
# Nombre (del catálogo) del modelo de embeddings para RAG; vacío = búsqueda de texto
LLMM_EMBEDDING_MODEL=
LLMM_EMBEDDING_DIM=1536
# Orígenes permitidos para CORS (frontend)
LLMM_CORS_ORIGINS=http://localhost:3000
# URL del backend vista desde el navegador
NEXT_PUBLIC_API_URL=http://localhost:8000
# Solo si usas el perfil "gateway" (proxy LiteLLM standalone)
LITELLM_MASTER_KEY=
